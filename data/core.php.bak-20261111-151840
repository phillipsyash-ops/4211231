// Полный адрес сайта (для расширения), без слэша в конце
function site_url(): string {
    if (SITE_URL !== '') return rtrim(SITE_URL, '/');
    $https = (!empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off')
        || strtolower($_SERVER['HTTP_X_FORWARDED_PROTO'] ?? '') === 'https'
        || ($_SERVER['SERVER_PORT'] ?? '') == 443;
    $path = rtrim(str_replace('\\', '/', dirname($_SERVER['SCRIPT_NAME'] ?? '/')), '/');
    if (preg_match('~/(admin|download)$~', $path)) $path = rtrim(dirname($path), '/');
    return ($https ? 'https' : 'http') . '://' . ($_SERVER['HTTP_HOST'] ?? 'localhost') . $path;
}

function asset(string $path): string {
    $base = preg_match('~/(admin|download)/~', $_SERVER['SCRIPT_NAME'] ?? '') ? '../' : '';
    $full = __DIR__ . '/../' . $path;
    return $base . $path . (is_file($full) ? '?v=' . filemtime($full) : '');
}
