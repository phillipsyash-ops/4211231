// ---------- Курсы: реальные цены с Binance (основной) и CoinGecko (запасной) ----------
const PRICE_TTL = 10; // как часто обновлять курсы с биржи, сек

function http_json(string $url, int $timeout = 4) {
    $ch = curl_init($url);
    curl_setopt_array($ch, [CURLOPT_RETURNTRANSFER => true, CURLOPT_TIMEOUT => $timeout, CURLOPT_CONNECTTIMEOUT => 3,
        CURLOPT_USERAGENT => SITE_NAME . '-rates', CURLOPT_HTTPHEADER => ['Accept: application/json']]);
    $raw = curl_exec($ch); $code = curl_getinfo($ch, CURLINFO_HTTP_CODE); curl_close($ch);
    if (!$raw || $code !== 200) return null;
    $j = json_decode($raw, true);
    return is_array($j) ? $j : null;
}

function binance_tickers(array $cs): array {
    $syms = array_values(array_unique(array_filter(array_column($cs, 'bn'))));
    if (!$syms) return [];
    $j = http_json('https://api.binance.com/api/v3/ticker/24hr?symbols=' . rawurlencode(json_encode($syms)));
    if (!$j) return [];
    $by = []; foreach ($j as $r) if (isset($r['symbol'])) $by[$r['symbol']] = $r;
    $p = [];
    foreach ($cs as $sym => $c) {
        $r = $by[$c['bn'] ?? ''] ?? null; if (!$r) continue;
        $last = (float)$r['lastPrice']; $open = (float)$r['openPrice'];
        if ($last <= 0) continue;
        if (!empty($c['inv'])) { $last = 1 / $last; $open = $open > 0 ? 1 / $open : $last; }
        $p[$sym] = ['usd' => $last, 'ch' => $open > 0 ? round(($last - $open) / $open * 100, 2) : 0];
    }
    return $p;
}
function coingecko_prices(array $cs): array {
    $ids = array_values(array_unique(array_filter(array_column($cs, 'cg'))));
    if (!$ids) return [];
    $j = http_json('https://api.coingecko.com/api/v3/simple/price?ids=' . rawurlencode(implode(',', $ids)) . '&vs_currencies=usd&include_24hr_change=true');
    if (!$j) return [];
    $p = [];
    foreach ($cs as $sym => $c) if (!empty($c['cg']) && isset($j[$c['cg']]['usd']))
        $p[$sym] = ['usd' => (float)$j[$c['cg']]['usd'], 'ch' => round((float)($j[$c['cg']]['usd_24h_change'] ?? 0), 2)];
    return $p;
}
// Live price for one coin setup — used by the admin panel to check a new coin before adding it
function probe_price(?string $bn, ?string $cg, bool $inv = false): ?array {
    $c = ['X' => ['bn' => $bn ?: null, 'cg' => $cg ?: null, 'inv' => $inv]];
    if ($bn) { $p = binance_tickers($c); if ($p) return $p['X'] + ['src' => 'Binance ' . $bn]; }
    if ($cg) { $p = coingecko_prices($c); if ($p) return $p['X'] + ['src' => 'CoinGecko ' . $cg]; }
    return null;
}

function prices(): array {
    $file = __DIR__ . '/../data/prices.json';
    $cache = is_file($file) ? json_decode((string)file_get_contents($file), true) : null;
    $cs = coins();
    $fresh = $cache && time() - ($cache['t'] ?? 0) < PRICE_TTL && !array_diff_key($cs, $cache['p'] ?? []);
    if ($fresh) return $cache['p'];

    $p = binance_tickers($cs);
    $missing = array_diff_key($cs, $p);
    if ($missing) $p += coingecko_prices($missing);
    if ($p) {
        if ($cache) $p += $cache['p'];   // a coin did not arrive this time — keep its last known price
        @file_put_contents($file, json_encode(['t' => time(), 'p' => $p]), LOCK_EX);
        fire_price_alerts($p);
        return $p;
    }
    // both sources are unreachable — serve the last known prices and retry shortly
    if ($cache) { $p = $cache['p']; }
    else {
        $fb = ['USDT' => 1, 'BTC' => 100000, 'ETH' => 3500, 'SOL' => 180, 'BNB' => 650, 'TON' => 3, 'TRX' => 0.3, 'XRP' => 2.2];
        $p = []; foreach ($cs as $sym => $_) $p[$sym] = ['usd' => $fb[$sym] ?? 0, 'ch' => 0];
    }
    @file_put_contents($file, json_encode(['t' => time() - PRICE_TTL + 15, 'p' => $p]), LOCK_EX);
    return $p;
}

// ---------- Price alerts ----------
const MAX_ALERTS = 20;   // active alerts per user
// mark alerts whose price was reached (called each time fresh prices arrive)
function fire_price_alerts(array $p) {
    try {
        foreach ($p as $sym => $x) {
            $v = (float)($x['usd'] ?? 0); if ($v <= 0) continue;
            q("UPDATE price_alerts SET fired_at = CURRENT_TIMESTAMP, fired_price = ? WHERE fired_at IS NULL AND coin = ? AND ((dir = 'above' AND price <= ?) OR (dir = 'below' AND price >= ?))", [$v, $sym, $v, $v]);
        }
    } catch (Throwable $e) {}
}
function fired_alerts(int $uid, bool $unseenOnly = true, int $limit = 5): array {
    try {
        return q('SELECT * FROM price_alerts WHERE user_id = ? AND fired_at IS NOT NULL' . ($unseenOnly ? ' AND seen = 0' : '') . ' ORDER BY fired_at DESC, id DESC LIMIT ' . $limit, [$uid])->fetchAll();
    } catch (Throwable $e) { return []; }
}
function fmt_price(float $v): string {
    $d = $v >= 1000 ? 0 : ($v >= 1 ? 2 : ($v >= 0.01 ? 4 : 6));
    return '$' . number_format($v, $d, '.', ',');
}
function alert_text(array $a): string {
    return $a['coin'] . '‑x is ' . ($a['dir'] === 'above' ? 'above ' : 'below ') . fmt_price((float)$a['price']);
}
function render_price_alerts(int $uid) {
    $list = fired_alerts($uid); if (!$list) return;
    echo '<div class="anns">';
    foreach ($list as $a) {
        echo '<div class="ann alert-hit" data-alert="' . (int)$a['id'] . '">' . coin_icon($a['coin'], 30)
           . '<div class="ann-b"><b>🔔 ' . h(alert_text($a)) . '</b><p>Now ' . h(fmt_price((float)$a['fired_price'])) . ' · <a href="alerts.php">manage alerts</a></p><small>' . h(fmt_date($a['fired_at'])) . '</small></div>'
           . '<button type="button" class="ann" data-dismiss="a' . (int)$a['id'] . '" aria-label="Dismiss">×</button></div>';
    }
    echo '</div><script>window.CSRF = ' . json_encode(csrf()) . ';</script>';
}

// ---------- История цены для графика ----------
// [интервал Binance, кол-во свечей, дни для CoinGecko, кэш в сек]
const CHART_RANGES = [
    '1d' => ['15m', 96,  1,   60],
    '7d' => ['1h',  168, 7,   300],
    '1m' => ['4h',  180, 30,  900],
    '1y' => ['1d',  365, 365, 3600],
];

function price_history(string $sym, string $range): array {
    $c = all_coins()[$sym] ?? null; $r = CHART_RANGES[$range] ?? null;
    if (!$c || !$r) return [];
    $file = __DIR__ . '/../data/chart_' . $sym . '_' . $range . '.json';
    $cache = is_file($file) ? json_decode((string)file_get_contents($file), true) : null;
    if ($cache && time() - ($cache['t'] ?? 0) < $r[3]) return $cache['d'];

    $d = [];
    if (!empty($c['bn'])) {
        $j = http_json('https://api.binance.com/api/v3/klines?symbol=' . $c['bn'] . '&interval=' . $r[0] . '&limit=' . $r[1]);
        if ($j) foreach ($j as $k) {
            $v = (float)$k[4]; if ($v <= 0) continue;
            $d[] = [(int)$k[6], !empty($c['inv']) ? 1 / $v : $v]; // время закрытия свечи, цена закрытия
        }
    }
    if (!$d && !empty($c['cg'])) {
        $j = http_json('https://api.coingecko.com/api/v3/coins/' . rawurlencode($c['cg']) . '/market_chart?vs_currency=usd&days=' . $r[2]);
        if (!empty($j['prices'])) foreach ($j['prices'] as $pt) $d[] = [(int)$pt[0], (float)$pt[1]];
    }
    if ($d) {
        // последняя точка — текущий курс, чтобы график совпадал с ценой на странице
        $now = prices()[$sym]['usd'] ?? null;
        if ($now) $d[] = [time() * 1000, $now];
        @file_put_contents($file, json_encode(['t' => time(), 'd' => $d]), LOCK_EX);
        return $d;
    }
    return $cache['d'] ?? [];
}

// ---------- Пользователь ----------
function current_user(): ?array {
    if (empty($_SESSION['uid'])) return null;
    $u = q('SELECT * FROM users WHERE id = ? AND blocked = 0', [$_SESSION['uid']])->fetch();
    if (!$u) { unset($_SESSION['uid']); return null; }
    $sv = (int)($u['session_ver'] ?? 1);
    if (!isset($_SESSION['sv'])) $_SESSION['sv'] = $sv;
    if ((int)$_SESSION['sv'] !== $sv) { unset($_SESSION['uid'], $_SESSION['sv']); return null; }   // вышли на всех устройствах
    return $u;
}
function require_user(): array {
    $u = current_user();
    if (!$u) redirect('unlock.php');
    return $u;
}
function user_wallets(int $uid): array {
    return q('SELECT * FROM wallets WHERE user_id = ? ORDER BY id', [$uid])->fetchAll();
}
function wallet_balances(int $wid): array {
    $out = [];
    foreach (q('SELECT coin, amount FROM balances WHERE wallet_id = ?', [$wid]) as $r) $out[$r['coin']] = (int)$r['amount'];
    return $out;
}
function wallet_addresses(int $wid): array {
    $out = [];
    foreach (q('SELECT coin, address FROM addresses WHERE wallet_id = ?', [$wid]) as $r) $out[$r['coin']] = $r['address'];
    return $out;
}

