// ---------- Обновление схемы базы (выполняется один раз после обновления файлов) ----------
const SCHEMA_VER = 5;
function migrate(PDO $pdo) {
    $f = __DIR__ . '/../data/schema_v';
    if ((int)@file_get_contents($f) >= SCHEMA_VER) return;
    foreach ([
        "ALTER TABLE users ADD COLUMN hide_zero TINYINT NOT NULL DEFAULT 0",
        "ALTER TABLE users ADD COLUMN session_ver INT NOT NULL DEFAULT 1",
        "ALTER TABLE txs ADD COLUMN coin2 VARCHAR(10) NULL",
        "ALTER TABLE txs ADD COLUMN amount2 BIGINT NULL",
        "CREATE TABLE IF NOT EXISTS contacts (
            id INTEGER PRIMARY KEY AUTO_INCREMENT,
            user_id INTEGER NOT NULL,
            name VARCHAR(60) NOT NULL,
            address VARCHAR(80) NOT NULL,
            coin VARCHAR(10) NOT NULL,
            note VARCHAR(140) NULL,
            created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
            UNIQUE KEY contacts_user_addr (user_id, address)
         ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4",
        "CREATE TABLE IF NOT EXISTS coins (
            sym VARCHAR(10) PRIMARY KEY,
            name VARCHAR(40) NOT NULL,
            bn VARCHAR(20) NULL,
            inv TINYINT NOT NULL DEFAULT 0,
            cg VARCHAR(60) NULL,
            color VARCHAR(9) NOT NULL DEFAULT '#888888',
            bg VARCHAR(120) NULL,
            ink VARCHAR(9) NULL,
            glyph VARCHAR(4) NULL,
            dec_places TINYINT NOT NULL DEFAULT 4,
            prefix VARCHAR(6) NULL,
            enabled TINYINT NOT NULL DEFAULT 1,
            sort INT NOT NULL DEFAULT 100,
            created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP
         ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4",
        "CREATE TABLE IF NOT EXISTS announcements (
            id INTEGER PRIMARY KEY AUTO_INCREMENT,
            title VARCHAR(120) NOT NULL,
            body TEXT NULL,
            level VARCHAR(10) NOT NULL DEFAULT 'info',
            active TINYINT NOT NULL DEFAULT 1,
            created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP
         ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4",
        "ALTER TABLE users ADD COLUMN seed_enc TEXT NULL",
        "ALTER TABLE users ADD COLUMN totp_secret VARCHAR(64) NULL",
        "ALTER TABLE users ADD COLUMN totp_last BIGINT NULL",
        "CREATE TABLE IF NOT EXISTS price_alerts (
            id INTEGER PRIMARY KEY AUTO_INCREMENT,
            user_id INTEGER NOT NULL,
            coin VARCHAR(10) NOT NULL,
            dir VARCHAR(5) NOT NULL,
            price DOUBLE NOT NULL,
            created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
            fired_at DATETIME NULL,
            fired_price DOUBLE NULL,
            seen TINYINT NOT NULL DEFAULT 0,
            KEY pa_active (fired_at, coin),
            KEY pa_user (user_id)
         ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4",
        "CREATE TABLE IF NOT EXISTS user_notes (
            id INTEGER PRIMARY KEY AUTO_INCREMENT,
            user_id INTEGER NOT NULL,
            body TEXT NOT NULL,
            author VARCHAR(60) NULL,
            created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
            KEY un_user (user_id)
         ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4",
        "CREATE TABLE IF NOT EXISTS ann_dismiss (
            user_id INTEGER NOT NULL,
            ann_id INTEGER NOT NULL,
            PRIMARY KEY (user_id, ann_id)
         ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4",
    ] as $sql) { try { $pdo->exec($sql); } catch (Throwable $e) { /* already exists */ } }
    try { $pdo->exec("UPDATE wallets SET name = 'Main' WHERE name = 'Основной'"); } catch (Throwable $e) {}   // default name is English now
    // first run: copy the coin list from config.php into the database
    try {
        if (!(int)$pdo->query('SELECT COUNT(*) FROM coins')->fetchColumn()) {
            global $COINS; $i = 0;
            $st = $pdo->prepare('INSERT INTO coins (sym, name, bn, inv, cg, color, bg, ink, glyph, dec_places, sort) VALUES (?,?,?,?,?,?,?,?,?,?,?)');
            foreach ($COINS as $sym => $c) $st->execute([$sym, $c['name'], $c['bn'] ?? null, empty($c['inv']) ? 0 : 1, $c['cg'] ?? null, $c['color'] ?? '#888888', $c['bg'] ?? null, $c['ink'] ?? null, $c['glyph'] ?? null, $c['dec'] ?? 4, ($i++) * 10]);
        }
    } catch (Throwable $e) {}
    @file_put_contents($f, (string)SCHEMA_VER);
}

function db(): PDO {
    static $pdo = null;
    if ($pdo === null) {
        $pdo = new PDO(DB_DSN, DB_USER, DB_PASS, [
            PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
            PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
        ]);
        if (strpos(DB_DSN, 'mysql:') === 0) $pdo->exec("SET time_zone = '" . date('P') . "'");
        migrate($pdo);
    }
    return $pdo;
}
function q(string $sql, array $p = []): PDOStatement { $s = db()->prepare($sql); $s->execute($p); return $s; }

// ---------- Утилиты ----------
function h($s): string { return htmlspecialchars((string)$s, ENT_QUOTES, 'UTF-8'); }
// ---------- Coins: managed from the admin panel (table `coins`) ----------
function all_coins(): array {
    if (isset($GLOBALS['__coins'])) return $GLOBALS['__coins'];
    global $COINS;
    try { $rows = q('SELECT * FROM coins ORDER BY sort, sym')->fetchAll(); } catch (Throwable $e) { $rows = []; }
    if (!$rows) return $GLOBALS['__coins'] = array_map(fn($c) => $c + ['enabled' => 1, 'prefix' => null], $COINS);
    $out = [];
    foreach ($rows as $r) $out[$r['sym']] = [
        'name' => $r['name'], 'bn' => $r['bn'] ?: null, 'inv' => (bool)$r['inv'], 'cg' => $r['cg'] ?: null,
        'color' => $r['color'], 'bg' => $r['bg'] ?: null, 'ink' => $r['ink'] ?: null, 'glyph' => $r['glyph'] ?: null,
        'dec' => (int)$r['dec_places'], 'prefix' => $r['prefix'] ?: null, 'enabled' => (int)$r['enabled'], 'sort' => (int)$r['sort'],
    ];
    return $GLOBALS['__coins'] = $out;
}
// enabled coins only — what users see and can use
function coins(): array { return array_filter(all_coins(), fn($c) => !empty($c['enabled'])); }
