// Текущий кошелёк пользователя (из ?w= или сессии)
function current_wallet(int $uid): array {
    $ws = user_wallets($uid);
    if (!$ws) { create_wallet($uid, 'Main'); $ws = user_wallets($uid); }
    $by = array_column($ws, null, 'id');
    $wid = (int)($_GET['w'] ?? $_SESSION['wid'] ?? 0);
    if (!isset($by[$wid])) $wid = (int)$ws[0]['id'];
    $_SESSION['wid'] = $wid;
    return [$by[$wid], $ws];
}

