// адрес → подпись: свои кошельки и контакты
function address_labels(int $uid): array {
    $m = [];
    foreach (q('SELECT a.address, w.name FROM addresses a JOIN wallets w ON w.id = a.wallet_id WHERE w.user_id = ?', [$uid]) as $r) $m[$r['address']] = ['name' => $r['name'], 'own' => true];
    foreach (user_contacts($uid) as $c) $m[$c['address']] = ['name' => $c['name'], 'own' => false];
    return $m;
}
function short_addr(?string $a): string { $a = (string)$a; return strlen($a) > 18 ? substr($a, 0, 8) . '…' . substr($a, -6) : $a; }

// Описание транзакции для истории с точки зрения кошелька $wid
function tx_view(array $t, int $wid, array $labels): array {
    $dec = fn($c) => all_coins()[$c]['dec'] ?? 8;
    if ($t['type'] === 'swap') {
        return ['kind' => 'swap', 'title' => 'Swap ' . $t['coin'] . '‑x → ' . $t['coin2'] . '‑x', 'peer' => $t['note'] ?? '', 'peerAddr' => null,
                'amount' => '−' . fmt_amount((int)$t['amount'], $dec($t['coin'])) . ' ' . $t['coin'] . '‑x',
                'amount2' => '+' . fmt_amount((int)$t['amount2'], $dec($t['coin2'])) . ' ' . $t['coin2'] . '‑x', 'in' => null];
    }
    $in = (int)$t['to_wallet'] === $wid && (int)$t['from_wallet'] !== $wid;
    $peerAddr = null;
    if ($t['type'] === 'credit') { $title = 'Credited'; $peer = SITE_NAME . ' ledger'; }
    elseif ($t['type'] === 'debit') { $title = 'Debited'; $peer = SITE_NAME . ' ledger'; }
    else {
        $title = $in ? 'Received' : 'Sent';
        $peerAddr = $in ? $t['from_addr'] : $t['to_addr'];
        $l = $labels[$peerAddr] ?? null;
        $peer = ($in ? 'from ' : 'to ') . ($l ? ($l['own'] ? 'your wallet “' . $l['name'] . '”' : $l['name']) . ' · ' . short_addr($peerAddr) : $peerAddr);
        if ($l) $peerAddr = null; // уже подписан — кнопка «в контакты» не нужна
    }
    return ['kind' => 'tx', 'title' => $title . ' · ' . $t['coin'] . '‑x', 'peer' => $peer, 'peerAddr' => $peerAddr, 'in' => $in,
            'amount' => ($in ? '+' : '−') . fmt_amount((int)$t['amount'], $dec($t['coin'])), 'amount2' => null];
}

