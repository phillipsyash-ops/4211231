function coin_icon(string $sym, int $size = 40): string {
    $c = all_coins()[$sym] ?? ['color' => '#888'];
    $style = '--c:' . ($c['color'] ?? '#888') . ';--cbg:' . ($c['bg'] ?? $c['color'] ?? '#888') . ';--ink:' . ($c['ink'] ?? '#fff')
           . ';width:' . $size . 'px;height:' . $size . 'px;font-size:' . round($size * .5) . 'px';
    return '<span class="coin-ic" style="' . h($style) . '" title="' . h($sym) . '‑x"><b>' . h($c['glyph'] ?? mb_substr($sym, 0, 1)) . '</b><i>x</i></span>';
}

