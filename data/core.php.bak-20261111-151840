function ann_html(string $text): string {
    $t = nl2br(h($text));
    return preg_replace('~(https?://[^\s<]+)~', '<a href="$1" target="_blank" rel="noopener">$1</a>', $t);
}
function render_announcements(int $uid) {
    $list = announcements_for($uid); if (!$list) return;
    $ic = ['info' => 'i', 'success' => '✓', 'warning' => '!'];
    echo '<div class="anns">';
    foreach ($list as $a) {
        $lv = in_array($a['level'], ['info', 'success', 'warning'], true) ? $a['level'] : 'info';
        echo '<div class="ann ann-' . $lv . '" data-ann="' . (int)$a['id'] . '"><span class="ann-ic">' . $ic[$lv] . '</span><div class="ann-b"><b>' . h($a['title']) . '</b>'
            . ($a['body'] ? '<p>' . ann_html($a['body']) . '</p>' : '') . '<small>' . h(fmt_date($a['created_at'], false)) . '</small></div>'
            . '<button type="button" class="ann" data-dismiss="' . (int)$a['id'] . '" aria-label="Dismiss">×</button></div>';
    }
    echo '</div><script>window.CSRF = ' . json_encode(csrf()) . ';</script>';
}

