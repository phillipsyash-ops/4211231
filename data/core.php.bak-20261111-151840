function announcements_for(int $uid): array {
    try {
        return q('SELECT a.* FROM announcements a LEFT JOIN ann_dismiss d ON d.ann_id = a.id AND d.user_id = ? WHERE a.active = 1 AND d.ann_id IS NULL ORDER BY a.id DESC LIMIT 3', [$uid])->fetchAll();
    } catch (Throwable $e) { return []; }
