// Подтверждение действий паролем. Возвращает null или текст ошибки. 5 ошибок подряд — пауза 5 минут.
function check_password(array $u, string $pw): ?string {
    $f = $_SESSION['pwf'] ?? ['n' => 0, 't' => 0];
    if ($f['n'] >= 5 && time() - $f['t'] < 300) return 'Too many wrong passwords. Try again in 5 minutes.';
    if ($pw !== '' && password_verify($pw, $u['pass_hash'])) { unset($_SESSION['pwf']); return null; }
    $_SESSION['pwf'] = ['n' => ($f['n'] >= 5 ? 0 : $f['n']) + 1, 't' => time()];
    return $pw === '' ? 'Enter your password to confirm.' : 'Wrong password.';
}

// ---------- Обмен монет ----------
// Сколько единиц $to получится за $amt единиц $from по текущему курсу (вниз до точности монеты)
function swap_quote(string $from, string $to, int $amt): array {
    $p = prices();
    $pf = $p[$from]['usd'] ?? 0; $pt = $p[$to]['usd'] ?? 0;
    if ($pf <= 0 || $pt <= 0) return [0, 0.0];
    $rate = $pf / $pt;
    $step = 10 ** (8 - (coins()[$to]['dec'] ?? 8));
    $out = (int)(floor($amt * $rate / $step) * $step);
    return [$out, $rate];
}
// Обменять внутри кошелька. $seenRate — курс, который видел пользователь (защита от скачка цены). true или текст ошибки.
function swap(int $wid, string $from, string $to, ?int $amt, ?float $seenRate = null) {
    if (!isset(coins()[$from], coins()[$to])) return 'Choose the coins.';
    if ($from === $to) return 'Choose two different coins.';
    if (!$amt) return 'Enter an amount greater than zero.';
    [$out, $rate] = swap_quote($from, $to, $amt);
    if ($out <= 0) return 'The amount is too small to swap.';
    if ($seenRate && abs($rate - $seenRate) / $seenRate > 0.01) return 'The rate moved by more than 1%. Check the amount and confirm again.';
    db()->beginTransaction();
    try {
        $d = q('UPDATE balances SET amount = amount - ? WHERE wallet_id = ? AND coin = ? AND amount >= ?', [$amt, $wid, $from, $amt]);
        if ($d->rowCount() !== 1) throw new RuntimeException('funds');
        q('UPDATE balances SET amount = amount + ? WHERE wallet_id = ? AND coin = ?', [$out, $wid, $to]);
        q('INSERT INTO txs (hash, type, coin, amount, coin2, amount2, from_wallet, to_wallet, note) VALUES (?,?,?,?,?,?,?,?,?)',
          [tx_hash(), 'swap', $from, $amt, $to, $out, $wid, $wid, 'Rate ' . rtrim(rtrim(number_format($rate, 8, '.', ''), '0'), '.')]);
        db()->commit();
        return true;
    } catch (Throwable $e) {
        db()->rollBack();
        return $e->getMessage() === 'funds' ? 'Not enough ' . $from . '‑x in this wallet.' : 'The swap failed. Please try again.';
    }
}

