// ---------- Суммы ----------
function parse_amount(string $s): ?int {
    $s = str_replace([',', ' '], ['.', ''], trim($s));
    if (!preg_match('/^(\d{1,12})(?:\.(\d{1,8}))?$/', $s, $m)) return null;
    $v = (int)$m[1] * UNIT + (int)str_pad($m[2] ?? '', 8, '0');
    return $v > 0 ? $v : null;
}
function fmt_amount(int $units, int $dec = 8): string {
    $neg = $units < 0; $units = abs($units);
    $s = intdiv($units, UNIT) . '.' . str_pad((string)($units % UNIT), 8, '0', STR_PAD_LEFT);
    $s = rtrim(rtrim(substr($s, 0, strpos($s, '.') + 1 + max($dec, 2)), '0'), '.');
    [$i, $f] = array_pad(explode('.', $s), 2, '');
    $i = number_format((int)$i, 0, '.', ',');
    return ($neg ? '−' : '') . $i . ($f !== '' ? '.' . $f : '');
}
function fmt_usd(float $v): string {
    return '$' . number_format($v, $v >= 1 || $v == 0 ? 2 : 6, '.', ',');
}
function fmt_date(string $dt, bool $time = true): string { return date($time ? 'M j, Y · H:i' : 'M j, Y', strtotime($dt)); }

// ---------- Сид-фраза ----------
function bip39_words(): array {
    static $w = null;
    if ($w === null) $w = array_map('trim', file(__DIR__ . '/bip39_english.txt', FILE_IGNORE_NEW_LINES));
    return $w;
}
function new_seed(int $n = 12): array {
    $w = bip39_words(); $out = [];
    for ($i = 0; $i < $n; $i++) $out[] = $w[random_int(0, 2047)];
    return $out;
}
function normalize_seed(string $s): string {
    $s = strtolower(preg_replace('/[^a-zA-Z]+/', ' ', $s));
    return trim(preg_replace('/\s+/', ' ', $s));
}
function seed_valid(string $norm): bool {
    $parts = explode(' ', $norm);
    if (!in_array(count($parts), [12, 24], true)) return false;
    $dict = array_flip(bip39_words());
    foreach ($parts as $p) if (!isset($dict[$p])) return false;
    return true;
}
function seed_fp(string $norm): string { return hash_hmac('sha256', $norm, SEED_PEPPER); }

// The phrase is stored encrypted with the user's own password (AES-256-GCM, key = PBKDF2(password + pepper)).
// Without the password nobody — not the admin, not someone with the database — can read it.
function seed_key(string $pw, string $salt): string { return hash_pbkdf2('sha256', $pw . SEED_PEPPER, $salt, 100000, 32, true); }
function seed_encrypt(string $norm, string $pw): string {
    $salt = random_bytes(16); $iv = random_bytes(12); $tag = '';
    $ct = openssl_encrypt($norm, 'aes-256-gcm', seed_key($pw, $salt), OPENSSL_RAW_DATA, $iv, $tag, 'loyal-seed');
    return 'v1:' . base64_encode($salt . $iv . $tag . $ct);
}
function seed_decrypt(?string $blob, string $pw): ?string {
    if (!$blob || strncmp($blob, 'v1:', 3) !== 0) return null;
    $raw = base64_decode(substr($blob, 3), true);
    if ($raw === false || strlen($raw) < 45) return null;
    $pt = openssl_decrypt(substr($raw, 44), 'aes-256-gcm', seed_key($pw, substr($raw, 0, 16)), OPENSSL_RAW_DATA, substr($raw, 16, 12), substr($raw, 28, 16), 'loyal-seed');
    return $pt === false ? null : $pt;
}

// ---------- Адреса ----------
function rand_from(string $alphabet, int $len): string {
    $s = ''; $max = strlen($alphabet) - 1;
    for ($i = 0; $i < $len; $i++) $s .= $alphabet[random_int(0, $max)];
    return $s;
}
function gen_address(string $coin): string {
    $b58 = '123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz';
    switch ($coin) {
        case 'BTC':  return 'bx1q' . rand_from('qpzry9x8gf2tvdw0s3jn54khce6mua7l', 38);
        case 'ETH':
        case 'BNB':  return '0x' . bin2hex(random_bytes(20));
        case 'USDT': return 'Tx' . rand_from($b58, 32);
        case 'TRX':  return 'TX' . rand_from($b58, 32);
        case 'SOL':  return 'X' . rand_from($b58, 43);
        case 'TON':  return 'UQx' . rand_from('ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_', 45);
        case 'XRP':  return 'rX' . rand_from($b58, 32);
        default:
            $pre = all_coins()[$coin]['prefix'] ?? null;
            return ($pre ?: strtoupper(substr($coin, 0, 1)) . 'x') . rand_from($b58, 34);
    }
}

// Создаёт кошелёк: адрес и нулевой баланс по каждой монете
function create_wallet(int $uid, string $name): int {
    q('INSERT INTO wallets (user_id, name) VALUES (?, ?)', [$uid, mb_substr($name, 0, 60)]);
    $wid = (int)db()->lastInsertId();
    foreach (array_keys(all_coins()) as $c) {
        for ($try = 0; $try < 5; $try++) {
            try { q('INSERT INTO addresses (wallet_id, coin, address) VALUES (?,?,?)', [$wid, $c, gen_address($c)]); break; }
            catch (PDOException $e) { if ($try === 4) throw $e; }
        }
        q('INSERT INTO balances (wallet_id, coin, amount) VALUES (?,?,0)', [$wid, $c]);
    }
    return $wid;
}

// Перевод между кошельками. Возвращает true или текст ошибки.
function transfer(int $wid, string $coin, string $to, ?int $amt, string $note = '') {
    $note = mb_substr(trim($note), 0, 140);
    if (!isset(coins()[$coin])) return 'Choose a coin.';
    if (!$amt) return 'Enter an amount greater than zero.';
    $dest = q('SELECT wallet_id, coin FROM addresses WHERE address = ?', [$to])->fetch();
    if (!$dest) return 'This address is not in the ledger.';
    if ($dest['coin'] !== $coin) return 'This is a ' . $dest['coin'] . '‑x address, but you are sending ' . $coin . '‑x.';
    if ((int)$dest['wallet_id'] === $wid) return 'You can’t send to an address of the same wallet.';
    $fromAddr = wallet_addresses($wid)[$coin] ?? null;
    db()->beginTransaction();
    try {
        $d = q('UPDATE balances SET amount = amount - ? WHERE wallet_id = ? AND coin = ? AND amount >= ?', [$amt, $wid, $coin, $amt]);
        if ($d->rowCount() !== 1) throw new RuntimeException('funds');
        q('UPDATE balances SET amount = amount + ? WHERE wallet_id = ? AND coin = ?', [$amt, $dest['wallet_id'], $coin]);
        q('INSERT INTO txs (hash, type, coin, amount, from_wallet, to_wallet, from_addr, to_addr, note) VALUES (?,?,?,?,?,?,?,?,?)',
          [tx_hash(), 'transfer', $coin, $amt, $wid, $dest['wallet_id'], $fromAddr, $to, $note ?: null]);
        db()->commit();
        return true;
    } catch (Throwable $e) {
        db()->rollBack();
        return $e->getMessage() === 'funds' ? 'Not enough ' . $coin . '‑x in this wallet.' : 'The transfer failed. Please try again.';
    }
}

